#!/usr/bin/env bash
#
# provision.sh — provisionne le VPS pour héberger {{APP_NAME}} AUX CÔTÉS des
# applications déjà en place (méthode : skill vps-provision).
#
# À exécuter EN ROOT sur le VPS, depuis une copie de ce fichier :
#   sudo bash provision.sh
#   DOMAIN=preprod.example.fr sudo -E bash provision.sh     # autre domaine
#
# Serveur partagé — ce script ne doit JAMAIS abîmer les autres sites :
#   - apt : n'installe que les paquets manquants, avec --no-upgrade, et s'arrête
#     si cela mettait à jour un paquet déjà installé (PHP, Node… servent à tous),
#     sauf ALLOW_UPGRADE=1 ;
#   - ~deploy/.ssh/config : on AJOUTE un alias « Host github.com-<slug> », on ne
#     réécrit jamais le fichier (les autres dépôts y ont leurs clés) ;
#   - crontab de deploy : on AJOUTE la ligne de ce site si elle manque, on ne
#     retire jamais celles des autres ;
#   - sudoers, vhost, service : fichiers propres à ce site ({{APP_SLUG}}-*).
#
# Idempotent : relançable sans casser l'existant. Aucun secret n'est lu depuis
# ce fichier — le mot de passe base et APP_KEY sont générés ici et écrits
# UNIQUEMENT dans le .env du serveur.
#
set -euo pipefail

# ── Paramètres ───────────────────────────────────────────────────────────────
APP_SLUG="{{APP_SLUG}}"
APP_NAME="{{APP_NAME}}"
DOMAIN="${DOMAIN:-{{DOMAIN}}}"
GITHUB_REPO="{{GITHUB_REPO}}"          # owner/repo
PHP_VERSION="{{PHP_VERSION}}"
NODE_MAJOR="{{NODE_VERSION}}"
APP_DIR="/var/www/${APP_SLUG}"
DEPLOY_USER="${DEPLOY_USER:-deploy}"
RUNNER_USER="${RUNNER_USER:-runner}"
BRANCH="${BRANCH:-main}"
# Alias SSH propre à ce site : le compte deploy sert peut-être déjà d'autres
# dépôts, chacun avec sa Deploy Key ; on n'écrit jamais « Host github.com ».
SSH_ALIAS="github.com-${APP_SLUG}"
REPO_SSH="git@${SSH_ALIAS}:${GITHUB_REPO}.git"

log() { printf '\n\033[1;32m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m/!\\ %s\033[0m\n' "$*"; }

[ "$(id -u)" -eq 0 ] || { warn "Exécutez ce script en root (sudo bash provision.sh)"; exit 1; }

export DEBIAN_FRONTEND=noninteractive

# Installe les paquets manquants sans jamais monter la version d'un paquet déjà
# installé : la simulation (lignes « Inst paquet [version actuelle] … ») révèle
# les mises à jour qu'apt ferait pour satisfaire les dépendances (ex. un
# php-intl neuf qui tire php-common 8.4.24 → 8.4.27 pour TOUS les sites).
installer_sans_monter() {
  local manquants=() paquet montees
  for paquet in "$@"; do
    dpkg-query -W -f='${Status}' "$paquet" 2>/dev/null | grep -q 'install ok installed' || manquants+=("$paquet")
  done
  [ "${#manquants[@]}" -gt 0 ] || return 0
  apt-get update -y
  montees="$(apt-get install -s --no-upgrade "${manquants[@]}" | awk '/^Inst [^ ]+ \[/ {print $2 " " $3}')"
  if [ -n "$montees" ] && [ "${ALLOW_UPGRADE:-0}" != "1" ]; then
    warn "Installer ${manquants[*]} mettrait à jour des paquets déjà utilisés par les autres sites :"
    sed 's/^/    /' <<<"$montees"
    warn "Relancez avec ALLOW_UPGRADE=1 si c'est voulu, ou installez ces paquets à la main."
    exit 1
  fi
  apt-get install -y --no-upgrade "${manquants[@]}"
}

# Pose un fichier sudoers après validation : un sudoers invalide casserait sudo
# pour tout le serveur.
poser_sudoers() {
  local cible="$1" contenu="$2" tmp
  tmp="$(mktemp)"
  printf '%s\n' "$contenu" > "$tmp"
  visudo -cf "$tmp" >/dev/null || { rm -f "$tmp"; warn "sudoers invalide pour $cible"; exit 1; }
  install -m 440 -o root -g root "$tmp" "$cible"
  rm -f "$tmp"
}

# ── 1. Chaîne d'outils partagée (sautée si déjà présente) ────────────────────
log "1/9 Chaîne d'outils (PHP ${PHP_VERSION}, Nginx, MariaDB, git, Node ${NODE_MAJOR})"

if ! command -v "php${PHP_VERSION}" >/dev/null 2>&1; then
  installer_sans_monter software-properties-common ca-certificates curl gnupg
  add-apt-repository -y ppa:ondrej/php || true
  apt-get update -y
fi

installer_sans_monter \
  "php${PHP_VERSION}-fpm" "php${PHP_VERSION}-cli" \
  "php${PHP_VERSION}-mbstring" "php${PHP_VERSION}-xml" "php${PHP_VERSION}-curl" \
  "php${PHP_VERSION}-zip" "php${PHP_VERSION}-intl" "php${PHP_VERSION}-gd" \
  "php${PHP_VERSION}-sqlite3" "php${PHP_VERSION}-mysql" "php${PHP_VERSION}-bcmath" \
  nginx mariadb-server mariadb-client git unzip openssl certbot python3-certbot-nginx

if ! command -v composer >/dev/null 2>&1; then
  curl -sS https://getcomposer.org/installer | "php${PHP_VERSION}" -- --install-dir=/usr/local/bin --filename=composer
fi

# Node est partagé lui aussi : on l'installe s'il manque, on ne le monte jamais
# de version dans le dos des autres sites.
if ! command -v node >/dev/null 2>&1; then
  curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash -
  installer_sans_monter nodejs
elif [ "$(node -p 'process.versions.node.split(".")[0]')" -lt "$NODE_MAJOR" ]; then
  if [ "${ALLOW_UPGRADE:-0}" != "1" ]; then
    warn "Node $(node -v) est installé, ${APP_NAME} veut Node ${NODE_MAJOR} : le monter toucherait tous les sites."
    warn "Relancez avec ALLOW_UPGRADE=1 si c'est voulu."
    exit 1
  fi
  curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash -
  apt-get install -y nodejs
fi

# ── 2. Base de données dédiée ────────────────────────────────────────────────
log "2/9 Base MariaDB '${APP_SLUG}' + utilisateur dédié"

DB_PASS_FILE="/root/.${APP_SLUG}_db_password"
if [ ! -f "$DB_PASS_FILE" ]; then
  openssl rand -base64 32 | tr -d '/+=' | head -c 32 > "$DB_PASS_FILE"
  chmod 600 "$DB_PASS_FILE"
fi
DB_PASSWORD="$(cat "$DB_PASS_FILE")"

mysql <<SQL
CREATE DATABASE IF NOT EXISTS \`${APP_SLUG}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '${APP_SLUG}'@'127.0.0.1' IDENTIFIED BY '${DB_PASSWORD}';
ALTER USER '${APP_SLUG}'@'127.0.0.1' IDENTIFIED BY '${DB_PASSWORD}';
GRANT ALL PRIVILEGES ON \`${APP_SLUG}\`.* TO '${APP_SLUG}'@'127.0.0.1';
FLUSH PRIVILEGES;
SQL

# ── 3. Utilisateur de déploiement (droits minimaux) ──────────────────────────
log "3/9 Utilisateur '${DEPLOY_USER}' + sudoers minimal (reload PHP-FPM uniquement)"

id -u "$DEPLOY_USER" >/dev/null 2>&1 || adduser --disabled-password --gecos '' "$DEPLOY_USER"
usermod -aG www-data "$DEPLOY_USER"

poser_sudoers "/etc/sudoers.d/${APP_SLUG}-deploy" \
  "${DEPLOY_USER} ALL=(root) NOPASSWD: /usr/bin/systemctl reload php${PHP_VERSION}-fpm"

# Runner GitHub Actions auto-hébergé (si présent) : il ne peut lancer QUE les
# scripts de ce site, en tant que ${DEPLOY_USER} (SETENV pour DEPLOY_REF…).
if id -u "$RUNNER_USER" >/dev/null 2>&1; then
  poser_sudoers "/etc/sudoers.d/${APP_SLUG}-runner" \
    "${RUNNER_USER} ALL=(${DEPLOY_USER}) NOPASSWD:SETENV: ${APP_DIR}/deploy/deploy.sh, ${APP_DIR}/deploy/rollback.sh"
fi

# ── 4. Clé de lecture GitHub (Deploy Key) ────────────────────────────────────
log "4/9 Clé SSH de lecture du dépôt (Deploy Key GitHub, alias ${SSH_ALIAS})"

DEPLOY_HOME="$(getent passwd "$DEPLOY_USER" | cut -d: -f6)"
install -d -m 700 -o "$DEPLOY_USER" -g "$DEPLOY_USER" "$DEPLOY_HOME/.ssh"

REPO_KEY="$DEPLOY_HOME/.ssh/${APP_SLUG}_repo"
if [ ! -f "$REPO_KEY" ]; then
  sudo -u "$DEPLOY_USER" ssh-keygen -t ed25519 -f "$REPO_KEY" -N "" -C "${APP_SLUG}-repo-read"
fi
# Le fichier config est partagé avec les autres sites : on ajoute notre bloc
# s'il manque, on ne réécrit jamais le fichier.
SSH_CONFIG="$DEPLOY_HOME/.ssh/config"
sudo -u "$DEPLOY_USER" touch "$SSH_CONFIG"
chmod 600 "$SSH_CONFIG"
if ! grep -qE "^Host[[:space:]]+${SSH_ALIAS}([[:space:]]|$)" "$SSH_CONFIG"; then
  sudo -u "$DEPLOY_USER" tee -a "$SSH_CONFIG" >/dev/null <<EOF

Host ${SSH_ALIAS}
  HostName github.com
  User git
  IdentityFile ${REPO_KEY}
  IdentitiesOnly yes
EOF
fi
# known_hosts : on ajoute github.com seulement s'il n'y est pas déjà.
KNOWN_HOSTS="$DEPLOY_HOME/.ssh/known_hosts"
if ! sudo -u "$DEPLOY_USER" ssh-keygen -F github.com -f "$KNOWN_HOSTS" >/dev/null 2>&1; then
  ssh-keyscan -t ed25519,rsa github.com 2>/dev/null | sudo -u "$DEPLOY_USER" tee -a "$KNOWN_HOSTS" >/dev/null
fi

# ── 5. Code & .env ───────────────────────────────────────────────────────────
log "5/9 Clone du dépôt et .env de production"

install -d -o "$DEPLOY_USER" -g www-data "$APP_DIR"

if [ ! -d "$APP_DIR/.git" ]; then
  if ! sudo -u "$DEPLOY_USER" git ls-remote "$REPO_SSH" >/dev/null 2>&1; then
    warn "Le dépôt n'est pas accessible avec cette clé."
    warn "Ajoutez la Deploy Key (lecture seule) sur GitHub :"
    warn "  Repo → Settings → Deploy keys → Add deploy key, puis RELANCEZ ce script."
    echo; cat "${REPO_KEY}.pub"; echo
    exit 0
  fi
  sudo -u "$DEPLOY_USER" git clone --branch "$BRANCH" "$REPO_SSH" "$APP_DIR"
fi
# Un clone fait avant l'alias pointe encore sur « github.com » : on le recâble.
sudo -u "$DEPLOY_USER" git -C "$APP_DIR" remote set-url origin "$REPO_SSH"

if [[ "$DOMAIN" =~ ^[0-9.]+$ ]]; then SCHEME="http"; SECURE="false"; else SCHEME="https"; SECURE="true"; fi
if [ ! -f "$APP_DIR/.env" ]; then
  sudo -u "$DEPLOY_USER" cp "$APP_DIR/deploy/env.production.example" "$APP_DIR/.env"
  sudo -u "$DEPLOY_USER" sed -i \
    -e "s|^DB_PASSWORD=.*|DB_PASSWORD=${DB_PASSWORD}|" \
    -e "s|^APP_URL=.*|APP_URL=${SCHEME}://${DOMAIN}|" \
    -e "s|^SESSION_SECURE_COOKIE=.*|SESSION_SECURE_COOKIE=${SECURE}|" \
    "$APP_DIR/.env"
fi
# Clé générée sans artisan : vendor/ n'existe pas encore au premier passage,
# `artisan key:generate` planterait et laisserait un .env sans clé (664).
# Un .env laissé sans clé par une version précédente du script est réparé.
if ! grep -qE '^APP_KEY=base64:.+' "$APP_DIR/.env"; then
  APP_KEY="base64:$(openssl rand -base64 32)"
  sed -i "s|^APP_KEY=.*|APP_KEY=${APP_KEY}|" "$APP_DIR/.env"
  grep -q '^APP_KEY=' "$APP_DIR/.env" || echo "APP_KEY=${APP_KEY}" >> "$APP_DIR/.env"
fi
chown "$DEPLOY_USER":www-data "$APP_DIR/.env"
chmod 640 "$APP_DIR/.env"

# ── 6. Premier build ─────────────────────────────────────────────────────────
log "6/9 Premier build (composer, npm, migrations, caches)"

# Toujours le PHP de ce site : le `php` par défaut du serveur peut être une
# autre version, choisie pour un autre site.
PHP_BIN="php${PHP_VERSION}"
COMPOSER_BIN="$(command -v composer)"
cd "$APP_DIR"
sudo -u "$DEPLOY_USER" "$PHP_BIN" "$COMPOSER_BIN" install --no-dev --optimize-autoloader --no-interaction
sudo -u "$DEPLOY_USER" npm ci
sudo -u "$DEPLOY_USER" npm run build
sudo -u "$DEPLOY_USER" "$PHP_BIN" artisan migrate --force
sudo -u "$DEPLOY_USER" "$PHP_BIN" artisan storage:link || true
sudo -u "$DEPLOY_USER" "$PHP_BIN" artisan optimize:clear
sudo -u "$DEPLOY_USER" "$PHP_BIN" artisan config:cache
sudo -u "$DEPLOY_USER" "$PHP_BIN" artisan route:cache
sudo -u "$DEPLOY_USER" "$PHP_BIN" artisan view:cache
sudo -u "$DEPLOY_USER" "$PHP_BIN" artisan event:cache
chown -R "$DEPLOY_USER":www-data "$APP_DIR"
chmod -R g+w "$APP_DIR/storage" "$APP_DIR/bootstrap/cache"
chmod 640 "$APP_DIR/.env"

# ── 7. Nginx ─────────────────────────────────────────────────────────────────
log "7/9 Vhost Nginx (${DOMAIN})"

# Le vhost du dépôt porte le domaine de production ; DOMAIN=… le remplace.
sed -E "s|^([[:space:]]*server_name)[[:space:]][^;]*;|\1 ${DOMAIN};|" \
  "$APP_DIR/deploy/nginx.conf" > "/etc/nginx/sites-available/${APP_SLUG}"
# Un autre vhost qui sert déjà ce domaine entrerait en conflit : on le signale
# sans y toucher.
for autre in /etc/nginx/sites-enabled/*; do
  [ "$(basename "$autre")" = "${APP_SLUG}" ] && continue
  if grep -qE "server_name[^;]*[[:space:]]${DOMAIN//./\\.}[[:space:];]" "$autre" 2>/dev/null; then
    warn "Le vhost $(basename "$autre") sert déjà ${DOMAIN} : à désactiver à la main avant de relancer."
  fi
done
ln -sf "/etc/nginx/sites-available/${APP_SLUG}" "/etc/nginx/sites-enabled/${APP_SLUG}"
# nginx -t d'abord : un vhost cassé ne doit jamais faire tomber les autres sites.
if ! nginx -t; then
  rm -f "/etc/nginx/sites-enabled/${APP_SLUG}"
  warn "Configuration Nginx invalide : vhost ${APP_SLUG} désactivé, les autres sites restent en ligne."
  exit 1
fi
systemctl reload nginx

# ── 8. HTTPS ─────────────────────────────────────────────────────────────────
if [ "$SCHEME" = "https" ]; then
  log "8/9 Certificat TLS (certbot) — nécessite que ${DOMAIN} pointe vers ce serveur"
  certbot --nginx -d "$DOMAIN" \
    --non-interactive --agree-tos --register-unsafely-without-email --redirect \
    || warn "certbot a échoué (DNS pas encore propagé ?) — relancez : certbot --nginx -d ${DOMAIN}"
else
  log "8/9 HTTPS sauté (adresse IP) — relancez avec DOMAIN=… quand le domaine existe"
fi

# ── 9. Scheduler + worker de queue ───────────────────────────────────────────
log "9/9 Cron scheduler + service systemd de queue"

CRON_LINE="* * * * * cd ${APP_DIR} && ${PHP_BIN} artisan schedule:run >> /dev/null 2>&1"
# La crontab de deploy porte aussi le scheduler des autres sites : on n'ajoute
# notre ligne que si aucune ne vise déjà ce dossier, sans rien retirer.
if ! sudo -u "$DEPLOY_USER" crontab -l 2>/dev/null | grep -qF "cd ${APP_DIR} && "; then
  ( sudo -u "$DEPLOY_USER" crontab -l 2>/dev/null || true ; echo "$CRON_LINE" ) \
    | sudo -u "$DEPLOY_USER" crontab -
fi

cp "$APP_DIR/deploy/${APP_SLUG}-queue.service" "/etc/systemd/system/${APP_SLUG}-queue.service"
systemctl daemon-reload
systemctl enable --now "${APP_SLUG}-queue"

# ── Récapitulatif ────────────────────────────────────────────────────────────
cat <<EOF

════════════════════════════════════════════════════════════════════
 PROVISIONING TERMINÉ — dernières étapes
════════════════════════════════════════════════════════════════════

1. Complétez ${APP_DIR}/.env (SMTP MAIL_*, clés tierces), puis :
     sudo -u ${DEPLOY_USER} ${PHP_BIN} ${APP_DIR}/artisan config:cache

2. Créez le premier administrateur (commande propre à l'application).

3. Vérifiez : ${SCHEME}://${DOMAIN}/up doit répondre 200, et les AUTRES
   sites du serveur aussi.

4. Sauvegarde hors serveur nocturne (mysqldump + copie distante) et sonde
   externe sur /up : voir le skill vps-provision, étape 10.
════════════════════════════════════════════════════════════════════
EOF
